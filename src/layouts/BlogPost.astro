---
import { Image } from 'astro:assets';
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	headings?: MarkdownHeading[];
	minutes?: number;
	related?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	series,
	draft = false,
	sources = [],
	headings = [],
	minutes,
	related = [],
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const kindLabel = {
	paper: 'Paper',
	video: 'Vídeo',
	talk: 'Talk',
	post: 'Post',
	docs: 'Documentação',
	repo: 'Repositório',
};
---

<html lang="pt-BR">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type={pubDate ? 'article' : 'website'}
		/>
	</head>

	<body>
		<Header />
		<main>
			<article data-pagefind-body={pubDate ? '' : undefined}>
				{draft && <p class="draft">Rascunho: não aparece no build de produção.</p>}

				<header class="post-header">
					<h1>{title}</h1>
					{pubDate && <p class="lede">{description}</p>}
					{
						pubDate && (
							<dl class="meta" data-pagefind-ignore>
								<div>
									<dt>Publicado</dt>
									<dd>
										<FormattedDate date={pubDate} />
										{minutes && <span> · {minutes} min de leitura</span>}
									</dd>
								</div>
								{updatedDate && (
									<div>
										<dt>Atualizado</dt>
										<dd>
											<FormattedDate date={updatedDate} />
										</dd>
									</div>
								)}
								{series && (
									<div>
										<dt>Série</dt>
										<dd>{series}</dd>
									</div>
								)}
								{tags.length > 0 && (
									<div>
										<dt>Temas</dt>
										<dd class="tags">
											{tags.map((t) => (
												<a href={`/tags/${t}/`}>{t}</a>
											))}
										</dd>
									</div>
								)}
							</dl>
						)
					}
				</header>

				{
					heroImage && (
						<Image class="hero" width={1020} height={510} src={heroImage} alt="" />
					)
				}

				{
					toc.length >= 3 && (
						<details class="toc" open data-pagefind-ignore>
							<summary>Nesta página</summary>
							<ul>
								{toc.map((h) => (
									<li class={`d${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</details>
					)
				}

				<div class="prose">
					<slot />
				</div>

				{
					sources.length > 0 && (
						<section class="sources">
							<h2 class="eyebrow">Fontes e créditos</h2>
							<p class="note">
								Este artigo é um resumo comentado. O conteúdo original pertence aos autores abaixo:
								leia na fonte.
							</p>
							<ul>
								{sources.map((s) => (
									<li>
										<span class="kind">{kindLabel[s.kind]}</span>
										<a href={s.url} target="_blank" rel="noopener">
											{s.title}
										</a>
										<span class="by">
											{s.author}
											{s.date && (
												<>
													{' · '}
													<FormattedDate date={s.date} />
												</>
											)}
										</span>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</article>

			{
				related.length > 0 && (
					<aside class="related" data-pagefind-ignore>
						<h2 class="eyebrow">Leia também</h2>
						<ul>
							{related.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>{p.data.title}</a>
									<span>{p.data.description}</span>
								</li>
							))}
						</ul>
					</aside>
				)
			}

			{pubDate && <Comments />}
		</main>
		<Footer />
	</body>
</html>

<style>
	.draft {
		padding: 0.6rem 1rem;
		border: 1px solid #e8d48a;
		border-radius: 6px;
		background: #fdf6d8;
		color: #5c4a00;
		font-family: var(--font-sans);
		font-size: 0.85rem;
	}
	.post-header {
		margin-bottom: 2rem;
	}
	.lede {
		margin: 0.5rem 0 1.5rem;
		color: var(--ink-muted);
		font-size: 1.2rem;
		line-height: 1.5;
	}
	.meta {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.85rem;
	}
	.meta div {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
	}
	.meta dt {
		color: var(--ink-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding-top: 0.1rem;
	}
	.meta dd {
		margin: 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.75rem;
	}
	.tags a {
		text-decoration: none;
	}
	.hero {
		width: 100%;
		margin-bottom: 2rem;
	}
	.toc {
		margin: 0 0 2.5rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		font-family: var(--font-sans);
		font-size: 0.875rem;
	}
	.toc summary {
		color: var(--ink-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.toc ul {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	.toc li.d3 {
		padding-left: 1rem;
		color: var(--ink-muted);
	}
	.toc a {
		color: var(--ink);
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
	}
	.prose :global(h2),
	.prose :global(h3) {
		scroll-margin-top: 1.5rem;
	}
	.sources,
	.related {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
	.sources h2,
	.related h2 {
		margin: 0 0 0.75rem;
	}
	.note {
		color: var(--ink-muted);
		font-size: 0.95rem;
	}
	.sources ul,
	.related ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sources li,
	.related li {
		display: flex;
		flex-direction: column;
		margin-bottom: 0.9rem;
	}
	.kind {
		color: var(--accent);
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.by,
	.related span {
		color: var(--ink-muted);
		font-family: var(--font-sans);
		font-size: 0.85rem;
	}
	.related a {
		font-weight: 600;
	}
</style>
