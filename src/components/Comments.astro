<section class="comments" id="comentarios">
	<h2 class="eyebrow">Comentários</h2>
	<div id="giscus"></div>
</section>

<!-- Injeta o giscus já no tema atual do site (o toggle do header atualiza depois via postMessage). -->
<script is:inline>
	(() => {
		const s = document.createElement('script');
		const attrs = {
			src: 'https://giscus.app/client.js',
			'data-repo': 'GuilhermeMoraes4/blog',
			'data-repo-id': 'R_kgDOVhYG4Q',
			'data-category': 'Announcements',
			'data-category-id': 'DIC_kwDOVhYG4c4DKSz5',
			'data-mapping': 'pathname',
			'data-strict': '1',
			'data-reactions-enabled': '1',
			'data-emit-metadata': '0',
			'data-input-position': 'top',
			'data-theme': document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light',
			'data-lang': 'pt',
			'data-loading': 'lazy',
			crossorigin: 'anonymous',
		};
		for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
		s.async = true;
		document.getElementById('giscus').appendChild(s);
	})();
</script>

<style>
	.comments {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
	.comments h2 {
		margin: 0 0 1rem;
	}
</style>
