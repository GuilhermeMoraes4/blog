---
import type { CollectionEntry } from 'astro:content';
import { groupByMonth, readingTime } from '../lib/posts';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const groups = groupByMonth(posts);
const day = (d: Date) =>
	d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', timeZone: 'UTC' }).replace('.', '');
---

{
	posts.length === 0 ? (
		<p class="empty">Nenhum artigo publicado ainda. O primeiro está a caminho.</p>
	) : (
		groups.map((g) => (
			<section class="group">
				<h2 class="eyebrow">
					{g.label} · {g.posts.length} {g.posts.length === 1 ? 'artigo' : 'artigos'}
				</h2>
				<ul>
					{g.posts.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString()}>{day(post.data.pubDate)}</time>
							<div>
								<a class="title" href={`/blog/${post.id}/`}>
									{post.data.title}
								</a>
								<p class="excerpt">{post.data.description}</p>
								<p class="meta">
									{post.data.tags.map((t) => (
										<a class="tag" href={`/tags/${t}/`}>
											#{t}
										</a>
									))}
									<span>{readingTime(post)} min de leitura</span>
								</p>
							</div>
						</li>
					))}
				</ul>
			</section>
		))
	)
}

<style>
	.group {
		margin-bottom: 2.5rem;
	}
	.group h2 {
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 1rem;
		margin: 0 0 1.75rem;
	}
	time {
		padding-top: 0.3rem;
		color: var(--ink-muted);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}
	.title {
		color: var(--ink);
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.excerpt {
		margin: 0.3rem 0 0.4rem;
		color: var(--ink-muted);
		font-size: 1rem;
		line-height: 1.55;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--font-sans);
		font-size: 0.8rem;
	}
	.empty {
		color: var(--ink-muted);
		font-style: italic;
	}
	@media (max-width: 560px) {
		li {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
