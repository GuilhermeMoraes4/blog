---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">Artigos</HeaderLink>
			<HeaderLink href="/tags">Temas</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
			<HeaderLink href="/busca">Busca</HeaderLink>
			<button id="theme-toggle" type="button" aria-label="Alternar tema claro/escuro">
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path
						d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	document.getElementById('theme-toggle').addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		// Mantém os comentários (giscus) no mesmo tema.
		const giscus = document.querySelector('iframe.giscus-frame');
		giscus?.contentWindow.postMessage(
			{ giscus: { setConfig: { theme: next === 'dark' ? 'dark_dimmed' : 'light' } } },
			'https://giscus.app',
		);
	});
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		max-width: calc(var(--measure) + 2rem);
		margin: 0 auto;
		padding: 1rem;
	}
	.brand {
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		font-size: 0.9rem;
	}
	.links :global(a) {
		color: var(--ink-muted);
		text-decoration: none;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--ink);
	}
	button {
		display: grid;
		place-items: center;
		padding: 0.3rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
	}
	button:hover {
		color: var(--ink);
	}
	.moon {
		display: none;
	}
	:global([data-theme='dark']) .sun {
		display: none;
	}
	:global([data-theme='dark']) .moon {
		display: block;
	}
</style>
