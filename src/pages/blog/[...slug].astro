---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, readingTime, relatedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, related: relatedPosts(post, posts) },
	}));
}
type Props = { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[] };

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} headings={headings} minutes={readingTime(post)} related={related}>
	<Content />
</BlogPost>
