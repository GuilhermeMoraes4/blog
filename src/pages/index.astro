---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 10);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="eyebrow">{SITE_TAGLINE}</p>
				<h1>Papers e talks de dados e IA, lidos por quem cuida do dado.</h1>
				<p>
					{SITE_DESCRIPTION} <a href="/about">Mais sobre o blog</a>.
				</p>
			</section>
			<PostList posts={posts} />
			{posts.length > 0 && <p class="all"><a href="/blog">Todos os artigos →</a></p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 3.5rem;
	}
	.intro h1 {
		margin: 0.6rem 0 1rem;
	}
	.intro p:last-child {
		color: var(--ink-muted);
		font-size: 1.1rem;
	}
	.all {
		font-family: var(--font-sans);
		font-size: 0.9rem;
	}
</style>
